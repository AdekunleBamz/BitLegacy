# BitLegacy — Environment Variables
# Copy this to .env.local and fill in your values

# Network: "testnet" or "mainnet"
NEXT_PUBLIC_NETWORK=testnet

# Your deployed contract address (after clarinet deploy)
NEXT_PUBLIC_CONTRACT_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM

# x402 payment recipient. Defaults to NEXT_PUBLIC_CONTRACT_ADDRESS if omitted.
NEXT_PUBLIC_X402_PAY_TO_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM

# x402 asset: "STX" or "sBTC"
NEXT_PUBLIC_X402_ASSET=STX

# x402 amount in on-chain base units.
# STX uses microSTX (6 decimals), sBTC uses sats (8 decimals).
# 10000 microSTX = 0.01 STX
NEXT_PUBLIC_X402_PRICE_MICRO=10000

# Optional Stacks-native x402 facilitator base URL.
# Leave blank in demo mode, or point this at your /verify + /settle capable service.
NEXT_PUBLIC_X402_FACILITATOR_URL=

# Set to "true" during development to accept demo payment signatures.
# Set to "false" when a real signer + facilitator flow is configured.
NEXT_PUBLIC_X402_DEMO=true

# IPFS storage key (get free key at nft.storage)
NEXT_PUBLIC_NFT_STORAGE_KEY=your_nft_storage_api_key_here

# App URL for OpenGraph
NEXT_PUBLIC_APP_URL=https://bitlegacy.vercel.app

# BitLegacy Environment Variables
# Copy to .env.local and fill in your values

# Network: "testnet" or "mainnet"
NEXT_PUBLIC_NETWORK=testnet

# Your deployed contract address
NEXT_PUBLIC_CONTRACT_ADDRESS=ST5K2RHMSBH4PAP4PGX77MCVNK1ZEED07EH98W0P

# x402 payment recipient (defaults to CONTRACT_ADDRESS if omitted)
NEXT_PUBLIC_X402_PAY_TO_ADDRESS=ST5K2RHMSBH4PAP4PGX77MCVNK1ZEED07EH98W0P

# x402 asset for the live browser wallet flow (currently "STX")
NEXT_PUBLIC_X402_ASSET=STX

# x402 price in base units (10000 microSTX = 0.01 STX)
NEXT_PUBLIC_X402_PRICE_MICRO=10000

# Optional Hiro API key for higher-rate server-side reads/payment verification
HIRO_API_KEY=

# IPFS storage key from nft.storage (server-side)
NFT_STORAGE_KEY=your_nft_storage_api_key_here

# App URL for OpenGraph
NEXT_PUBLIC_APP_URL=https://bitlegacy.vercel.app
